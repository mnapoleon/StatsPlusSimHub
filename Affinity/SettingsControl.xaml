<UserControl x:Class="Affinity.SettingsControl"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins"
             Background="Black"
             mc:Ignorable="d"
             d:DesignHeight="540"
             d:DesignWidth="900">
    <UserControl.Resources>
        <SolidColorBrush x:Key="AffinityPageBrush" Color="#0A0A0D" />
        <SolidColorBrush x:Key="AffinityPanelBrush" Color="#141419" />
        <SolidColorBrush x:Key="AffinityPanelAltBrush" Color="#1C1C22" />
        <SolidColorBrush x:Key="AffinityBorderBrush" Color="#2A2A33" />
        <SolidColorBrush x:Key="AffinityTabIdleBrush" Color="#17171C" />
        <SolidColorBrush x:Key="AffinityAccentBrush" Color="#F28C28" />

        <Style TargetType="{x:Type styles:SHSection}">
            <Setter Property="Background" Value="{StaticResource AffinityPanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AffinityBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{StaticResource AffinityAccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AffinityAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="18,6" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="Transparent"
                                Padding="0"
                                SnapsToDevicePixels="False">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12"
                                    MinHeight="{TemplateBinding MinHeight}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"
                                                  RecognizesAccessKey="True" />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.94" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AffinityTabControlStyle" TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="{StaticResource AffinityPageBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AffinityPageBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid Background="{TemplateBinding Background}"
                              ClipToBounds="False"
                              KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TabPanel Grid.Row="0"
                                      Background="{StaticResource AffinityPageBrush}"
                                      ClipToBounds="False"
                                      HorizontalAlignment="Center"
                                      IsItemsHost="True"
                                      Margin="0,0,0,8" />

                            <Border Grid.Row="1"
                                    Background="{StaticResource AffinityPageBrush}"
                                    BorderBrush="{StaticResource AffinityPageBrush}"
                                    BorderThickness="0"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AffinityTabItemStyle" TargetType="{x:Type TabItem}">
            <Setter Property="Background" Value="{StaticResource AffinityTabIdleBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AffinityTabIdleBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Panel.ZIndex" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border Background="Transparent"
                                Padding="0,0,8,0"
                                ClipToBounds="False">
                            <Grid ClipToBounds="False">
                                <Border x:Name="TabBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        MinWidth="{TemplateBinding MinWidth}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter x:Name="TabHeader"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      ContentSource="Header"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                                      RecognizesAccessKey="True" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource AffinityAccentBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AffinityAccentBrush}" />
                                <Setter TargetName="TabHeader" Property="TextElement.Foreground" Value="Black" />
                                <Setter Property="Panel.ZIndex" Value="10" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource AffinityPanelAltBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AffinityPanelAltBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource AffinityAccentBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AffinityAccentBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="Background" Value="{StaticResource AffinityPanelBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AffinityBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource AffinityBorderBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource AffinityBorderBrush}" />
            <Setter Property="RowBackground" Value="{StaticResource AffinityPanelBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{StaticResource AffinityPanelBrush}" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
        </Style>
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="{StaticResource AffinityPanelAltBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AffinityBorderBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="{StaticResource AffinityPanelBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AffinityBorderBrush}" />
        </Style>
        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="Background" Value="{StaticResource AffinityPanelBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AffinityBorderBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{StaticResource AffinityPageBrush}" VerticalScrollBarVisibility="Auto">
        <Grid Margin="16" Background="{StaticResource AffinityPageBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Affinity" />

            <TabControl Grid.Row="1"
                        Margin="0,16,0,0"
                        SelectedIndex="0"
                        Style="{StaticResource AffinityTabControlStyle}"
                        ItemContainerStyle="{StaticResource AffinityTabItemStyle}">
                <TabItem Header="Settings">
                    <StackPanel Background="Black">
                        <styles:SHSection Title="General">
                            <StackPanel Margin="12">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Margin="0,0,12,8"
                                               VerticalAlignment="Center"
                                               Text="Enable plugin" />
                                    <CheckBox Grid.Row="0"
                                              Grid.Column="1"
                                              Margin="0,0,0,8"
                                              HorizontalAlignment="Left"
                                              IsChecked="{Binding Settings.EnablePlugin, Mode=TwoWay}" />

                                    <TextBlock Grid.Row="1"
                                               Grid.Column="0"
                                               Margin="0,0,12,0"
                                               VerticalAlignment="Center"
                                               Text="Distance units" />
                                    <CheckBox Grid.Row="1"
                                              Grid.Column="1"
                                              HorizontalAlignment="Left"
                                              Content="Display miles"
                                              Checked="DistanceUnitChanged"
                                              Unchecked="DistanceUnitChanged"
                                              IsChecked="{Binding Settings.DisplayInMiles, Mode=TwoWay}" />
                                </Grid>

                                <StackPanel Orientation="Horizontal">
                                    <Button Width="90" Click="SaveButton_Click" Content="Save" />
                                    <Button Width="110" Margin="8,0,0,0" Click="ResetButton_Click" Content="Reset Settings" />
                                </StackPanel>
                            </StackPanel>
                        </styles:SHSection>

                        <styles:SHSection Title="Debug">
                            <StackPanel Margin="12">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Margin="0,0,12,0"
                                               VerticalAlignment="Center"
                                               Text="Debug logging" />
                                    <CheckBox Grid.Column="1"
                                              HorizontalAlignment="Left"
                                              Content="Write telemetry debug log"
                                              IsChecked="{Binding Settings.EnableDebugLogging, Mode=TwoWay}" />
                                </Grid>

                                <TextBlock Margin="0,0,0,8" TextWrapping="Wrap">
                                    Debug logs are written to separate files per game. Use the checkboxes below to control which games produce telemetry logs when debug logging is enabled.
                                </TextBlock>

                                <ItemsControl ItemsSource="{Binding GameDebugLoggingOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Margin="0,0,0,6"
                                                      Content="{Binding DisplayName}"
                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                            </StackPanel>
                        </styles:SHSection>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Data">
                    <StackPanel Background="Black">
                        <styles:SHSection Title="Live Summary">
                            <StackPanel Margin="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="0"
                                                   Margin="0,0,12,8"
                                                   FontWeight="Bold"
                                                   Text="Current total" />
                                        <StackPanel Grid.Row="0"
                                                    Grid.Column="1"
                                                    Grid.ColumnSpan="2"
                                                    Margin="0,0,0,8"
                                                    Orientation="Horizontal">
                                            <TextBlock Text="{Binding CurrentContextDistanceDisplay, StringFormat=F2}" />
                                            <TextBlock Margin="4,0,0,0" Text="{Binding DistanceUnitLabel}" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="0"
                                                   Margin="0,0,12,8"
                                                   FontWeight="Bold"
                                                   Text="Session" />
                                        <StackPanel Grid.Row="1"
                                                    Grid.Column="1"
                                                    Grid.ColumnSpan="2"
                                                    Margin="0,0,0,8"
                                                    Orientation="Horizontal">
                                            <TextBlock Text="{Binding SessionDistanceDisplay, StringFormat=F2}" />
                                            <TextBlock Margin="4,0,0,0" Text="{Binding DistanceUnitLabel}" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="0"
                                                   Margin="0,0,12,8"
                                                   FontWeight="Bold"
                                                   Text="Total laps" />
                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="1"
                                                   Grid.ColumnSpan="2"
                                                   Margin="0,0,0,8"
                                                   Text="{Binding CurrentContextCompletedLaps}" />

                                        <TextBlock Grid.Row="3"
                                                   Grid.Column="0"
                                                   Margin="0,0,12,0"
                                                   FontWeight="Bold"
                                                   Text="Session laps" />
                                        <TextBlock Grid.Row="3"
                                                   Grid.Column="1"
                                                   Grid.ColumnSpan="2"
                                                   Text="{Binding SessionCompletedLaps}" />
                                    </Grid>

                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                        <TextBlock HorizontalAlignment="Right"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Text="Total distance across all games:" />
                                        <StackPanel Margin="0,4,0,0"
                                                    HorizontalAlignment="Right"
                                                    Orientation="Horizontal">
                                            <TextBlock VerticalAlignment="Center"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding TotalDistanceDisplay, StringFormat=F2}" />
                                            <TextBlock Margin="4,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding DistanceUnitLabel}" />
                                        </StackPanel>
                                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding GameTabs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,2,0,0"
                                                                HorizontalAlignment="Right"
                                                                Orientation="Horizontal">
                                                        <TextBlock VerticalAlignment="Center"
                                                                   FontSize="12"
                                                                   Text="{Binding GameName}" />
                                                        <TextBlock Margin="8,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Text="{Binding TotalDistanceDisplay, StringFormat=F2}" />
                                                        <TextBlock Margin="8,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="12"
                                                                   Text="{Binding TotalCompletedLaps, StringFormat={}({0} laps)}" />
                                                        <TextBlock Margin="4,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="12"
                                                                   Text="{Binding DataContext.DistanceUnitLabel, ElementName=Root}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </styles:SHSection>

                        <styles:SHSection Title="Stored Distance">
                            <StackPanel Margin="12">
                                <Border Margin="0,0,0,0"
                                        Background="Black"
                                        BorderBrush="Black"
                                        BorderThickness="0">
                                    <TabControl Background="Black"
                                                BorderBrush="Black"
                                                Height="300"
                                                ItemsSource="{Binding GameTabs}"
                                                SelectedItem="{Binding SelectedGameTab, Mode=TwoWay}"
                                                Style="{StaticResource AffinityTabControlStyle}">
                                        <TabControl.ItemContainerStyle>
                                            <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource AffinityTabItemStyle}">
                                                <Setter Property="Header" Value="{Binding GameName}" />
                                            </Style>
                                        </TabControl.ItemContainerStyle>
                                        <TabControl.ContentTemplate>
                                            <DataTemplate>
                                                <Border Background="Black"
                                                        BorderBrush="Black"
                                                        BorderThickness="0"
                                                        Padding="0"
                                                        Margin="0,-6,0,0">
                                                    <Grid Margin="0,8,0,0" Background="Black">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <Border Grid.Row="0"
                                                        Grid.Column="0"
                                                        Background="Black">
                                                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="Tracks" />
                                                </Border>
                                                <Border Grid.Row="0"
                                                        Grid.Column="1"
                                                        Background="Black" />
                                                <Border Grid.Row="0"
                                                        Grid.Column="2"
                                                        Background="Black">
                                                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="Cars" />
                                                </Border>

                                                <Border Grid.Row="1"
                                                        Background="Black"
                                                        BorderBrush="#3A3A3A"
                                                        BorderThickness="1">
                                                    <DataGrid AutoGenerateColumns="False"
                                                              Background="Black"
                                                              BorderThickness="0"
                                                              CanUserAddRows="False"
                                                              CanUserDeleteRows="False"
                                                              IsReadOnly="True"
                                                              ItemsSource="{Binding TrackSummaries}">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Width="*" Binding="{Binding TrackDisplayName}" Header="Track" />
                                                            <DataGridTextColumn Width="120" Binding="{Binding DistanceDisplay, StringFormat=F2}">
                                                                <DataGridTextColumn.Header>
                                                                    <TextBlock Text="{Binding DataContext.DistanceColumnHeader, ElementName=Root}" />
                                                                </DataGridTextColumn.Header>
                                                            </DataGridTextColumn>
                                                            <DataGridTextColumn Width="110" Binding="{Binding CompletedLaps}" Header="Laps" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </Border>

                                                <Border Grid.Row="1"
                                                        Grid.Column="1"
                                                        Background="Black" />

                                                <Border Grid.Row="1"
                                                        Grid.Column="2"
                                                        Background="Black"
                                                        BorderBrush="#3A3A3A"
                                                        BorderThickness="1">
                                                    <DataGrid AutoGenerateColumns="False"
                                                              Background="Black"
                                                              BorderThickness="0"
                                                              CanUserAddRows="False"
                                                              CanUserDeleteRows="False"
                                                              IsReadOnly="True"
                                                              ItemsSource="{Binding CarSummaries}">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Width="*" Binding="{Binding CarModel}" Header="Car" />
                                                            <DataGridTextColumn Width="120" Binding="{Binding DistanceDisplay, StringFormat=F2}">
                                                                <DataGridTextColumn.Header>
                                                                    <TextBlock Text="{Binding DataContext.DistanceColumnHeader, ElementName=Root}" />
                                                                </DataGridTextColumn.Header>
                                                            </DataGridTextColumn>
                                                            <DataGridTextColumn Width="110" Binding="{Binding CompletedLaps}" Header="Laps" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </TabControl.ContentTemplate>
                                    </TabControl>
                                </Border>

                                <StackPanel Margin="0,12,0,0"
                                            HorizontalAlignment="Right">
                                    <TextBlock TextAlignment="Right"
                                               Foreground="{Binding StatusSectionForeground}"
                                               Text="{Binding DataStatus}" />
                                    <TextBlock Margin="0,4,0,0"
                                               TextAlignment="Right"
                                               Foreground="{Binding StatusSectionForeground}"
                                               Text="{Binding CurrentContext}" />
                                    <TextBlock Margin="0,4,0,0"
                                               TextAlignment="Right"
                                               Foreground="{Binding StatusSectionForeground}"
                                               Text="{Binding DatabasePath}" />
                                </StackPanel>

                                <Button Width="90"
                                        Margin="0,12,0,0"
                                        HorizontalAlignment="Left"
                                        Click="RefreshButton_Click"
                                        Content="Refresh" />
                            </StackPanel>
                        </styles:SHSection>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </ScrollViewer>
</UserControl>
