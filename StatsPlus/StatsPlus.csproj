<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AssemblyName>StatsPlus</AssemblyName>
    <RootNamespace>StatsPlus</RootNamespace>
    <SimHubInstallPath Condition="'$(SimHubInstallPath)' == ''">C:\Program Files (x86)\SimHub\</SimHubInstallPath>
    <StartAction>Program</StartAction>
    <StartProgram>$(SimHubInstallPath)SimHubWPF.exe</StartProgram>
    <StartWorkingDirectory>$(SimHubInstallPath)</StartWorkingDirectory>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Test'">
    <UseSimHubSdkStubs>true</UseSimHubSdkStubs>
    <SimHubInstallPath>C:\does-not-exist</SimHubInstallPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseSimHubSdkStubs)' != 'true'">
    <Reference Include="SimHub.Plugins">
      <HintPath>C:\Program Files (x86)\SimHub\SimHub.Plugins.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="GameReaderCommon">
      <HintPath>C:\Program Files (x86)\SimHub\GameReaderCommon.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="MahApps.Metro">
      <HintPath>C:\Program Files (x86)\SimHub\MahApps.Metro.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>C:\Program Files (x86)\SimHub\Newtonsoft.Json.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="SimHub.Logging">
      <HintPath>C:\Program Files (x86)\SimHub\SimHub.Logging.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="log4net">
      <HintPath>C:\Program Files (x86)\SimHub\log4net.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(UseSimHubSdkStubs)' == 'true'">
    <ProjectReference Include="..\SdkStubs\SimHub.Plugins\SimHub.Plugins.csproj" />
    <ProjectReference Include="..\SdkStubs\GameReaderCommon\GameReaderCommon.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="assets\statsplus-icon-24.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="ac_track_id_map.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyPluginToSimHub" AfterTargets="Build" Condition="Exists('$(SimHubInstallPath)')">
    <ItemGroup>
      <PluginOutput Include="$(TargetDir)**\*.*"
                    Exclude="$(TargetDir)ref\**\*.*;
                             $(TargetDir)GameReaderCommon.dll;
                             $(TargetDir)GameReaderCommon.pdb;
                             $(TargetDir)SimHub.Plugins.dll;
                             $(TargetDir)SimHub.Plugins.pdb;
                             $(TargetDir)SimHub.Logging.dll;
                             $(TargetDir)Newtonsoft.Json.dll;
                             $(TargetDir)MahApps.Metro.dll;
                             $(TargetDir)log4net.dll" />
    </ItemGroup>
    <Message Text="Copying StatsPlus build output to $(SimHubInstallPath)" Importance="High" />
    <Copy SourceFiles="@(PluginOutput)"
          DestinationFiles="@(PluginOutput->'$(SimHubInstallPath)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="false" />
  </Target>
</Project>
